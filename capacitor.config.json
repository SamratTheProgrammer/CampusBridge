{
  "appId": "com.campusbridge.app",
  "appName": "CampusBridge",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://campus-bridge-x5rl.vercel.app",
    "androidScheme": "https",
    "iosScheme": "https",
    "cleartext": true,
    "allowNavigation": [
      "campus-bridge-x5rl.vercel.app",
      "*.vercel.app",
      "*.clerk.accounts.dev",
      "clerk.accounts.dev",
      "*.accounts.dev",
      "accounts.google.com",
      "*.google.com",
      "*.gstatic.com"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1800,
      "launchAutoHide": true,
      "backgroundColor": "#0a0f1d",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false,
      "splashFullScreen": true,
      "splashImmersive": true
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0f1d",
      "overlaysWebView": false
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnFullScreen": true
    }
  }
}
